# Oodle credentials
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Model credential. eve's default model routes through the Vercel
# AI Gateway; this demo calls OpenAI directly so it runs without a
# Vercel account.
OPENAI_API_KEY=your-openai-api-key

# Model id
MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible gateway instead.
# OPENAI_GATEWAY_URL=https://your-gateway.example.com/v1
