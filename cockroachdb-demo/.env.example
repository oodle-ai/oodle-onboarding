# Oodle Configuration
# Get these values from your Oodle UI: Settings -> API Keys
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Logical name for this CockroachDB cluster. Becomes the `cluster` label on
# every metric, so you can run several clusters into one Oodle instance.
CRDB_CLUSTER_NAME=crdb-demo

# How often the collector scrapes each node's /_status/vars endpoint.
CRDB_SCRAPE_INTERVAL=15s
