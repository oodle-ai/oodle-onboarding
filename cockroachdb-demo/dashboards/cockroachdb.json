{
  "dashboard": {
    "annotations": {
      "list": []
    },
    "description": "CockroachDB cluster health, SQL throughput and latency, transactions, and per-node storage and resource usage. Fed by the OTel Collector scraping /_status/vars on every node.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "panels": [
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "panels": [],
        "title": "Cluster Health",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "Nodes the cluster considers live. Should equal your node count.",
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "noValue": "0",
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "max(liveness_livenodes{crdb_cluster=~\"$cluster\"})",
            "legendFormat": "Live Nodes",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Live Nodes",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "Ranges with fewer replicas than the zone config requires. Sustained non-zero means a node is down or rebalancing is stuck.",
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "noValue": "0",
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 1
