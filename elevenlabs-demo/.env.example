# Oodle: Settings -> API Keys in the Oodle UI.
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
# Defaults to https://<OODLE_INSTANCE>-otlp.collector.oodle.ai
# OODLE_OTLP_ENDPOINT=

# ElevenLabs: an API key with access to ElevenAgents (read and write).
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: the LLM of the demo agent, and the voice of the synthetic caller.
# ELEVENLABS_LLM=gpt-4.1-mini
# CALLER_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
