# Oodle credentials. Used by TRACER=litellm-otel and
# TRACER=laminar-to-oodle.
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Laminar, for TRACER=laminar. Self-hosted defaults; a project
# API key is created in the Laminar UI (http://localhost:5667).
LMNR_PROJECT_API_KEY=your-laminar-project-api-key
LMNR_BASE_URL=http://host.docker.internal
LMNR_HTTP_PORT=8000
LMNR_GRPC_PORT=8001

# The provider key that matches MODEL. The default model is an
# OpenAI one because OpenAI caches any prompt prefix over 1024
# tokens on its own, which is what makes the cache column show.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
MODEL=gpt-4o-mini

# Who is talking. Both ids ride on every model call as LiteLLM
# `metadata`, which is where Laminar reads them from.
SESSION_ID=demo-session-1
USER_ID=demo-user

# How many turns the session runs. Each turn is one trace.
TURNS=2
