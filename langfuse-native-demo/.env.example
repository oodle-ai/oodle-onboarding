# Oodle credentials
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
OODLE_API_DOMAIN=us1.oodle.ai

# LLM provider
OPENAI_API_KEY=your-openai-api-key
MODEL=gpt-4o-mini

# Optional: an OpenAI-compatible gateway instead.
# OPENAI_GATEWAY_URL=https://your-gateway.example.com/v1

# Only for `make run-dual`, the dual-write variant: the Langfuse project
# that receives the same spans Oodle does.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
