# Shared by all three sub-demos and the destination scripts.
# Copy to .env and fill in.

# --- Oodle ---
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-opus-5-5

# --- SDK tracing (claude-sdk, managed-agents) ---
# metadata_only (the SDK default): ids, timing, status, token counts.
# content: also the prompts and responses on each span.
ANTHROPIC_OPEN_TELEMETRY_TRACES_CONTENT_MODE=content

# --- API tracing destination (scripts/create-destination.sh) ---
# Content mode of the spans Anthropic sends to Oodle: metadata_only | content
DESTINATION_CONTENT_MODE=content
# "all", or a comma-separated list of workspace ids (wrkspc_...) to cover only those.
DESTINATION_WORKSPACES=all

# --- Managed Agents ---
# Printed by `make managed-agents-setup`; paste them here.
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=
