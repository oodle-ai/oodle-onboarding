# Shared by all three sub-demos and the destination scripts.
# Copy to .env and fill in.

# --- Oodle ---
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-opus-5-5
# Needed when ANTHROPIC_API_KEY is not scoped to a workspace (the API answers
# 400 "must include the anthropic-workspace-id header"). Console → Settings →
# Workspaces; ids start with wrkspc_. The destination must cover this workspace.
ANTHROPIC_WORKSPACE_ID=

# --- SDK tracing (claude-sdk, managed-agents) ---
# metadata_only (the SDK default): ids, timing, status, token counts.
# content: also the prompts and responses on each span.
ANTHROPIC_OPEN_TELEMETRY_TRACES_CONTENT_MODE=content

# --- API tracing destination (scripts/create-destination.sh) ---
# Content mode of the spans Anthropic sends to Oodle: metadata_only | content
DESTINATION_CONTENT_MODE=content
# "all", or a comma-separated list of workspace ids (wrkspc_...) to cover only those.
DESTINATION_WORKSPACES=all

# --- Managed Agents ---
# Printed by `make managed-agents-setup`; paste them here.
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=

# --- MCP backend ---
# Printed by `make mcp-backend-setup`: an environment that allows MCP egress.
MCP_ENVIRONMENT_ID=
# Optional. A public URL for mcp-web's /mcp, used instead of the quick tunnel.
MCP_PUBLIC_URL=
# Model of the in-house chat path and of the MCP server's search step.
CHAT_MODEL=claude-haiku-4-5
SEARCH_MODEL=claude-haiku-4-5
