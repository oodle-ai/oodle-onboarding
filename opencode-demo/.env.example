# Oodle Configuration
# Get these values from your Oodle UI: Settings -> API Keys
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
# The Oodle API domain, shown on the OpenCode tile (us1.oodle.ai for US)
OODLE_API_DOMAIN=us1.oodle.ai

# Google Gemini: the model OpenCode actually calls
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional
# OPENCODE_MODEL=google/gemini-2.5-pro
# OTEL_SERVICE_NAME=opencode
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_USER_ID=demo-user
