# Oodle credentials
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# LiteLLM routes to whichever provider the model names, so set the
# key that matches MODEL.
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key

# LiteLLM model string
# Examples: gpt-4o-mini, anthropic/claude-sonnet-4-20250514,
#           gemini/gemini-2.0-flash
MODEL=gpt-4o-mini

# Optional: point the OpenAI-compatible route at a gateway.
# OPENAI_GATEWAY_URL=https://your-gateway.example.com/v1
