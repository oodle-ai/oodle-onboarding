# Oodle credentials
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Model credential. Flue reads OPENAI_API_KEY for openai/* models.
OPENAI_API_KEY=your-openai-api-key

# Flue model specifier (provider/model). For Anthropic, set
# MODEL=anthropic/claude-haiku-4-5 and pass ANTHROPIC_API_KEY instead.
MODEL=openai/gpt-4.1-mini

# Optional: send OpenAI requests through an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
