# Oodle Configuration
# Get these values from your Oodle UI: Settings -> API Keys
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Google Gemini — the model OpenClaw actually calls
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional
# OPENCLAW_MODEL=google/gemini-2.5-flash
# OTEL_SERVICE_NAME=openclaw
