AWS_PROFILE=default
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
# Optional: use the OTLP base URL from your Oodle integration record.
# OODLE_OTLP_ENDPOINT=https://your-instance-id-otlp.collector.oodle.ai

# These demos use fictional orders. Set false to redact prompt/tool content.
CAPTURE_CONTENT=true

AGENTCORE_AGENT_NAME=oodle_order_support_demo
