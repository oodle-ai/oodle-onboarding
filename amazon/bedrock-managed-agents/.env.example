AWS_PROFILE=default
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
STACK_NAME=oodle-bedrock-managed-agents-demo

OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
# Base URL from the Oodle integration record; no /v1/traces suffix.
# OODLE_OTLP_ENDPOINT=https://your-instance-id-otlp.collector.oodle.ai
CAPTURE_CONTENT=true

# make deploy discovers these from CloudFormation. Set them to use an existing agent.
# BEDROCK_AGENT_ID=ABCDEFGHIJ
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# Real AWS tools. Use fixture only for explicit offline demonstrations.
TOOL_DATA_SOURCE=aws
TOOLS_STACK_NAME=oodle-bedrock-managed-agents-tools
# Optional overrides when reading existing resources instead of make tools-deploy:
# ORDERS_TABLE_NAME=existing-orders-table
# RETURN_POLICY_PARAMETER=/existing/return-policy
# TOOL_RUNTIME_ROLE_NAME=existing-agentcore-execution-role
# AWS Knowledge MCP uses https://knowledge-mcp.global.api.aws without credentials.
