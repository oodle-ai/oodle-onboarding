# Shared visual language for the blog figures. Keep all assets native to D2.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 32
  }
}

style.fill: "#FFFFFF"

classes: {
  title: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#173541"}
  }
  caption: {
    shape: text
    near: bottom-center
    style: {font-size: 18; font-color: "#566A75"}
  }
  card: {
    label: ""
    width: 320
    height: 180
    grid-columns: 1
    grid-gap: 12
    style: {
      fill: "#EFF5FD"
      stroke: "#B7CDE8"
      stroke-width: 1
      border-radius: 14
    }
  }
  oodle: {
    style: {fill: "#EBF7F3"; stroke: "#9ACDBE"}
  }
  gate: {
    style: {fill: "#FFF6E6"; stroke: "#E7C17D"}
  }
  human: {
    style: {fill: "#F5F0FB"; stroke: "#CAB8E4"}
  }
  tag: {
    shape: text
    style: {font-size: 14; bold: true; font-color: "#3D6397"}
  }
  # A tag that ends in a product logo instead of the product name. The
  # container is invisible so only the number and the mark read as the tag.
  logo-tag: {
    label: ""
    grid-rows: 1
    grid-gap: 0
    horizontal-gap: 8
    width: 168
    height: 28
    style: {fill: transparent; stroke: transparent}
  }
  temporal-logo: {
    shape: image
    icon: assets/temporal.svg
    width: 24
    height: 24
  }
  oodle-logo: {
    shape: image
    icon: assets/oodle.svg
    width: 21
    height: 26
  }
  heading: {
    shape: text
    style: {font-size: 24; bold: true; font-color: "#173541"}
  }
  body: {
    shape: text
    style: {font-size: 19; font-color: "#3E5665"}
  }
  detail: {
    shape: text
    style: {font-size: 17; font-color: "#566A75"}
  }
  activity: {
    width: 184
    height: 66
    style: {
      fill: "#FFFFFF"
      stroke: "#B7CDE8"
      stroke-width: 1
      border-radius: 8
      font-size: 20
      font-color: "#234B7C"
    }
  }
  # Label fills add visible padding between text and connecting lines.
  flow: {
    style: {fill: "#FFFFFF"; stroke: "#718693"; stroke-width: 2; font-size: 17; font-color: "#566A75"}
  }
  success: {
    style: {fill: "#FFFFFF"; stroke: "#23836C"; stroke-width: 2; font-size: 17; font-color: "#1C715D"}
  }
  approval: {
    style: {fill: "#FFFFFF"; stroke: "#8763AE"; stroke-width: 2; stroke-dash: 4; font-size: 17; font-color: "#79579E"}
  }
}
