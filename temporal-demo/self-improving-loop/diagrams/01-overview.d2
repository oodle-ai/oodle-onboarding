...@_style

# A clockwise loop. Declare rows first to keep the reading order stable.
grid-rows: 2
grid-columns: 2
horizontal-gap: 112
vertical-gap: 84

title: The self-improving loop {class: title}

agent: {
  class: card
  tag: {
    class: logo-tag
    num: "01 /" {class: tag}
    logo: "" {class: temporal-logo}
  }
  heading: Support agent {class: heading}
  body: "Answer tickets with\nthe production prompt" {class: body}
}

observe: {
  class: [card; oodle]
  tag: {
    class: logo-tag
    num: "02 /" {class: tag; style.font-color: "#23765F"}
    logo: "" {class: oodle-logo}
  }
  heading: Find the failures {class: heading}
  body: "Find tool-call errors\nin production traces" {class: body}
}

promote: {
  class: [card; oodle]
  tag: {
    class: logo-tag
    num: "04 / HUMAN +" {class: tag; style.font-color: "#23765F"}
    logo: "" {class: oodle-logo}
  }
  heading: Promote the prompt {class: heading}
  body: "Approve, then move production\nto the new prompt version" {class: body}
}

improve: {
  class: card
  tag: {
    class: logo-tag
    num: "03 /" {class: tag}
    logo: "" {class: temporal-logo}
  }
  heading: Prompt improver {class: heading}
  body: "Draft a prompt; replay tickets.\nRequire zero bad tool calls." {class: body}
}

agent -> observe: traces {class: flow}
observe -> improve: findings {class: flow}
improve -> promote: passes {class: success}
promote -> agent: next run {class: success}

caption: "A new prompt version. A label moves. No deploy." {class: caption}
