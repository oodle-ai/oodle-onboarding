...@_style

# A clockwise loop. Declare rows first to keep the reading order stable.
grid-rows: 2
grid-columns: 2
horizontal-gap: 112
vertical-gap: 84

title: The self-improving loop {class: title}

agent: {
  class: [card; marked; temporal-mark]
  tag: 01 / TEMPORAL {class: tag}
  heading: Support agent {class: heading}
  body: "Answer tickets" {class: body}
}

observe: {
  class: [card; oodle; marked; oodle-mark]
  tag: 02 / OODLE {class: tag; style.font-color: "#23765F"}
  heading: Find the failures {class: heading}
  body: "Find agent failures\nin production" {class: body}
}

promote: {
  class: [card; oodle; marked; oodle-mark]
  tag: 04 / HUMAN + OODLE {class: tag; style.font-color: "#23765F"}
  heading: Promote the prompt {class: heading}
  body: "Approve, then move production\nto the new prompt version" {class: body}
}

improve: {
  class: [card; marked; temporal-mark]
  tag: 03 / TEMPORAL {class: tag}
  heading: Prompt improver {class: heading}
  body: "Draft a prompt; replay tickets" {class: body}
}

agent -> observe: traces {class: flow}
observe -> improve: findings {class: flow}
improve -> promote: passes {class: success}
promote -> agent: next run {class: success}
