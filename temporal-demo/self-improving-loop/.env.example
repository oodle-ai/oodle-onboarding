# Oodle. Get these from Settings > API Keys.
# OODLE_APP_URL is the app host, not the telemetry collector host.
OODLE_APP_URL=https://app.oodle.ai
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Google Gemini. Get a key from https://aistudio.google.com/apikey
# Run `make models` if this one runs out of free allowance.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo settings
PROMPT_NAME=order-support-agent
AGENT_NAME=order_support_agent
SERVICE_NAME=support-agent

# How the improver behaves once it is started
INSIGHT_POLL_SECONDS=120
IMPROVER_COOLDOWN_MINUTES=10
IMPROVER_MAX_ATTEMPTS=3
