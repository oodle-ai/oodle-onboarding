# Which tracing path writes the spans. Both write to Langfuse and Oodle.
#   otel         — two OpenTelemetry OTLP exporters (app/tracing_otel.py)
#   langfuse-sdk — the Langfuse Python SDK (app/tracing_langfuse.py)
#   none         — no tracing
TRACING_BACKEND=otel

# Destination one: your Langfuse project.
# Langfuse Cloud, or your own host. A self-hosted Langfuse running in a
# different compose project is reached as http://host.docker.internal:<its
# published port> — its in-project hostname does not resolve from here.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Destination two: your Oodle instance.
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key
OODLE_API_DOMAIN=us1.oodle.ai

# The voice pipeline. STT, LLM and TTS are all OpenAI.
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# What the traces are labelled with.
OTEL_SERVICE_NAME=pipecat-demo
AGENT_NAME=pipecat-voice-agent
ENVIRONMENT=demo

# Optional: print every span to stdout as well.
# OTEL_CONSOLE_EXPORT=true

# Optional: an OpenAI-compatible gateway instead of api.openai.com.
# Only if the OpenAI calls go through a gateway. Leave it commented out
# rather than set to an empty value.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
