# Oodle Configuration
# Get these values from your Oodle UI: Settings -> API Keys
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# Google Gemini Configuration (used by app, rag-server; agent when PROVIDER=google)
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Agent service — LangGraph ReAct agent
# Provider: "anthropic" (default, matches the blog example) or "google"
# PROVIDER=anthropic

# Anthropic Configuration (required when PROVIDER=anthropic)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the default model (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Tavily Configuration (required for the agent's search tool)
# Get your API key from https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key
