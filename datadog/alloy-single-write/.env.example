# Oodle Configuration (single-write via the Datadog intake path)
# Get these from: oodle integrations list -o json  (the DATADOG entry)
#   OODLE_API_KEY         -> integration record apiKey (or your Oodle API key)
#   OODLE_COLLECTOR_DOMAIN-> integration record collectorDomain
#   OODLE_INSTANCE_ID     -> your Oodle instance id
OODLE_API_KEY=your-oodle-api-key
OODLE_COLLECTOR_DOMAIN=your-instance.collector.oodle.ai
OODLE_INSTANCE_ID=your-instance-id

# Load Generator (optional)
LOAD_DURATION=86400
LOAD_INTERVAL=3
