{
  "name": "fieldwork-mobile-demo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^22.20.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "setup:device": "node scripts/device-demo.mjs setup",
    "api:device": "node scripts/device-demo.mjs api",
    "build:android": "node scripts/device-demo.mjs android",
    "install:android": "npm run build:android && node scripts/install-android.mjs",
    "serve:android": "node scripts/install-android.mjs",
    "build:ios": "node scripts/device-demo.mjs ios",
    "install:ios": "node scripts/device-demo.mjs install-ios",
    "prepare:ios": "node scripts/device-demo.mjs prepare-ios",
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "api": "node --import tsx server/index.ts",
    "worker": "node --import tsx server/worker.ts",
    "dev": "concurrently -k -n api,expo \"npm:api\" \"npm:web\"",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "format": "prettier --write App.tsx index.ts app.config.ts src server tests docs scripts/*.ts scripts/*.js scripts/*.mjs scripts/*.html README.md AGENTS.md *.json *.js compose.yaml",
    "smoke:stack": "node --import tsx scripts/smoke-stack.ts"
  },
  "dependencies": {
    "@datadog/browser-rum": "^6.0.0",
    "@datadog/mobile-react-native": "3.12.0",
    "@datadog/mobile-react-native-session-replay": "3.12.0",
    "@expo/vector-icons": "^15.1.1",
    "@oodle-ai/mobile-sdk-reactnative": "^0.1.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "cors": "^2.8.5",
    "dd-trace": "^5.0.0",
    "dotenv": "^17.0.0",
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-datadog": "58.0.0",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "redis": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@datadog/mobile-react-native-babel-plugin": "3.12.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "concurrently": "^9.0.0",
    "prettier": "^3.6.0",
    "qrcode": "1.5.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  }
}
