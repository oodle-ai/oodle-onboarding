# Set a LAN address for physical devices. Use HTTPS outside a trusted local network.
EXPO_PUBLIC_API_URL=http://localhost:4310
ALLOW_LOCAL_HTTP=true

# Optional local signing and native push. Local notifications need neither setting.
IOS_APPLE_TEAM_ID=
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
ANDROID_GOOGLE_SERVICES_FILE=

# Public client configuration. Use a new React Native RUM application for this demo.
EXPO_PUBLIC_DD_ENABLED=false
EXPO_PUBLIC_DD_APPLICATION_ID=
EXPO_PUBLIC_DD_CLIENT_TOKEN=
EXPO_PUBLIC_DD_SITE=US1
EXPO_PUBLIC_DD_ENV=demo
EXPO_PUBLIC_DD_SESSION_SAMPLE_RATE=100
EXPO_PUBLIC_DD_REPLAY_SAMPLE_RATE=100
EXPO_PUBLIC_DD_TRACE_SAMPLE_RATE=100

# Native telemetry provider: datadog (default), oodle, or both. See docs/OODLE.md.
EXPO_PUBLIC_TELEMETRY_PROVIDER=datadog
EXPO_PUBLIC_OODLE_INSTANCE_ID=
EXPO_PUBLIC_OODLE_RUM_API_KEY=
EXPO_PUBLIC_OODLE_RUM_ENDPOINT=
EXPO_PUBLIC_OODLE_ENV=demo
EXPO_PUBLIC_OODLE_SESSION_SAMPLE_RATE=100
EXPO_PUBLIC_OODLE_REPLAY_SAMPLE_RATE=100
EXPO_PUBLIC_OODLE_TRACE_SAMPLE_RATE=100

# Optional web preview telemetry requires a separate Browser RUM application.
EXPO_PUBLIC_DD_WEB_APPLICATION_ID=
EXPO_PUBLIC_DD_WEB_CLIENT_TOKEN=

# Backend configuration. These values must never use the EXPO_PUBLIC_ prefix.
HOST=127.0.0.1
PORT=4310
SESSION_SECRET=
DATA_FILE=./data/state.json
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ENABLE_DEMO_SCENARIOS=true
DD_TRACE_ENABLED=false
DD_SERVICE=fieldwork-demo-api
DD_ENV=demo
DD_SITE=datadoghq.com
DD_API_KEY=
DD_TRACE_AGENT_URL=http://localhost:8126
DATADOG_UPLOAD_ENABLED=false

# Build-only symbol upload credentials. Do not expose these to the client.
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# Set to 0.0.0.0 only for phone access on a trusted LAN.
API_BIND_HOST=127.0.0.1
