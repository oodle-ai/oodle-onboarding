{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".."
  },
  "include": [
    "**/*.ts",
    "../src/shared/**/*.ts",
    "../tests/**/*.ts",
    "../scripts/smoke-stack.ts"
  ]
}
