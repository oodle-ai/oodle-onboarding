# Oodle instance ID, from Settings or `oodle configure`.
OODLE_INSTANCE=inst-your-instance-id
# Oodle API key with the DataIngestion role.
OODLE_API_KEY=your-api-key
# OTLP endpoint of the instance. The pattern is
# https://<instance>-otlp.collector.oodle.ai
OODLE_OTLP_ENDPOINT=https://inst-your-instance-id-otlp.collector.oodle.ai

# AWS region for the stack.
AWS_REGION=us-west-2
