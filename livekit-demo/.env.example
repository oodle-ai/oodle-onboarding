# Oodle Configuration
# Get these values from your Oodle UI: Settings -> API Keys
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# --- The live voice agent (make voice). The replay needs none of this. ---

# The voice pipeline. STT, LLM and TTS are all OpenAI.
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4.1-mini
FALLBACK_LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# The PII mode for a call whose client does not ask for one: allow or
# withhold. The demo page always asks.
DEFAULT_PII_MODE=allow

# What the traces are labelled with.
OTEL_SERVICE_NAME=livekit-voice-worker
AGENT_NAME=livekit-demo-agent
AGENT_ID=maple-street-sales-agent
ENVIRONMENT=demo

# The local LiveKit server's key pair. The defaults work as they are.
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=local-dev-secret-not-for-production

# Optional: print every span to stdout as well.
# OTEL_CONSOLE_EXPORT=true

# Optional: an OpenAI-compatible gateway instead of api.openai.com.
# Leave it commented out rather than set to an empty value.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
