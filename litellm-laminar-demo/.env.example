# Laminar project API key (Laminar dashboard, project settings)
LMNR_PROJECT_API_KEY=your-laminar-project-api-key

# Oodle credentials
OODLE_INSTANCE=your-instance-id
OODLE_API_KEY=your-api-key

# LiteLLM routes to whichever provider MODEL names; set the matching key.
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
MODEL=gpt-4o-mini
# Router model groups are named <model>__reasoning-<effort>.
REASONING_EFFORT=medium

# true: scripted replies, no provider key needed. Spans are identical in shape.
MOCK_LLM=false

# false reproduces the pre-fix behaviour (orphaned chat spans in Oodle).
OODLE_MIRROR_LAMINAR_SPANS=true

# Namespace for route-audit attributes on LLM and turn spans.
ROUTE_ATTRIBUTE_PREFIX=agent.route.

# true also sends prompts, completions, tool schemas and tool/turn payloads
# to Oodle. Laminar receives them either way.
OODLE_CAPTURE_MESSAGE_CONTENT=false

# The agent compacts its history at 80% (soft) or 87.5% (hard) of this
# window. Kept small so `make test-long-session` compacts more than once.
CONTEXT_WINDOW_TOKENS=600
